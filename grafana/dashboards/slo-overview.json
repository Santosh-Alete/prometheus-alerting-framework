{
  "dashboard": {
    "title": "SLO Overview",
    "uid": "slo-overview",
    "tags": ["slo", "reliability"],
    "timezone": "browser",
    "refresh": "30s",
    "templating": {
      "list": [
        {
          "name": "cluster",
          "type": "query",
          "query": "label_values(up, cluster)",
          "refresh": 2
        },
        {
          "name": "service",
          "type": "query",
          "query": "label_values(http_requests_total{cluster=\"$cluster\"}, service)",
          "refresh": 2
        }
      ]
    },
    "panels": [
      {
        "title": "Availability - Current",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "service:availability:ratio_rate1h{cluster=\"$cluster\", service=\"$service\"}",
            "legendFormat": "{{service}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "orange", "value": 0.99},
                {"color": "green", "value": 0.999}
              ]
            },
            "min": 0.95,
            "max": 1,
            "unit": "percentunit"
          }
        }
      },
      {
        "title": "Latency P50 / P95 / P99",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "service:http_latency:p50{cluster=\"$cluster\", service=\"$service\"}",
            "legendFormat": "p50"
          },
          {
            "expr": "service:http_latency:p95{cluster=\"$cluster\", service=\"$service\"}",
            "legendFormat": "p95"
          },
          {
            "expr": "service:http_latency:p99{cluster=\"$cluster\", service=\"$service\"}",
            "legendFormat": "p99"
          }
        ],
        "fieldConfig": {
          "defaults": {"unit": "s"}
        }
      },
      {
        "title": "Error Rate",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "expr": "service:http_error_ratio:rate5m{cluster=\"$cluster\", service=\"$service\"}",
            "legendFormat": "error rate"
          }
        ],
        "fieldConfig": {
          "defaults": {"unit": "percentunit"}
        }
      },
      {
        "title": "Error Budget Remaining (30d)",
        "type": "stat",
        "gridPos": {"h": 4, "w": 24, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "1 - ((1 - service:availability:ratio_rate24h{cluster=\"$cluster\", service=\"$service\"}) / 0.001)",
            "legendFormat": "{{service}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "orange", "value": 0.25},
                {"color": "green", "value": 0.5}
              ]
            }
          }
        }
      }
    ]
  }
}
